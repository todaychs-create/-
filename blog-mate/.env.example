# 이 파일을 참고해 Vercel 프로젝트의 "Environment Variables"에 값을 넣으세요.
# (이 파일 자체에는 실제 값을 넣지 말고, 저장소에도 커밋하지 마세요.)

# Anthropic(Claude) API 키 — https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-...

# Pixabay API 키 — https://pixabay.com/api/docs/ (로그인 후 상단에 표시)
PIXABAY_API_KEY=00000000-...

# 앱 접속용 공용 비밀번호 (나와 동생이 함께 쓸 하나의 비밀번호)
SHARED_PASSWORD=우리끼리정한비밀번호
